      "top": "18mm",
      "bottom": "22mm",
      "baseline": "3mm"
    },
    "property-a4": {
      "$type": "grid",
      "width": "210mm",
      "height": "297mm",
      "columns": 12,
      "gutter": "4mm",
      "margin": "15mm",
      "top": "15mm",
      "bottom": "18mm",
      "baseline": "3mm",
      "use": "fact sheet, unit sheet"
    },
    "property-a3": {
      "$type": "grid",
      "width": "297mm",
      "height": "420mm",
      "columns": 12,
      "gutter": "5mm",
      "margin": "20mm",
      "top": "20mm",
      "bottom": "24mm",
      "baseline": "4mm",
      "use": "floor-plan sheet, sales-centre poster"
    }
