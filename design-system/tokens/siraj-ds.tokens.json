    },
    "md": {
      "$type": "shadow",
      "$value": "0 16px 40px -16px rgba(44, 15, 18, 0.22)",
      "$description": "Dialogs, drawers."
    },
    "drape": {
      "$type": "shadow",
      "$value": "0 30px 60px -30px rgba(23, 6, 8, 0.45)",
