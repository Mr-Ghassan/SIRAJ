        "$value": 800,
        "$description": "Arabic display pairing only (200 ↔ 800)."
      }
    }
  },
  "typography": {
    "$description": "Arabic line-height minimums (client rule 2026-10-13): display/H1 ≥ 1.3 (also for 700+ weights and 200↔800 pairs), H2/H3 ≥ 1.4, body/caption/small/data ≥ 1.6, labels ≥ 1.4 — Arabic lines never touch. Bilingual roles. Sizes in px, desktop (1440) and mobile (390); CSS interpolates fluidly between them. Arabic letter-spacing is always 0.",
    "display": {
      "$type": "typography",
      "usage": "One statement per view: hero lines, covers. Arabic may pair 200 with 800.",
      "ar": {
        "family": "arabic",
        "desktop": 92,
        "mobile": 52,
        "weight": 300,
        "lineHeight": 1.36,
        "letterSpacing": "0"
      },
      "en": {
        "family": "latin",
        "desktop": 88,
        "mobile": 50,
        "weight": 300,
        "lineHeight": 1.04,
        "letterSpacing": "-0.01em"
      }
    },
