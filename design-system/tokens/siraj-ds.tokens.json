    },
    "silk": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "The Silk Corner — the single radius of the system. One corner (top-end: top-left in RTL) of an image container, at most twice per view. Clamp with min(…, 33%) on small boxes."
    }
