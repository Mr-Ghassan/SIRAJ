  "font": {
    "family": {
      "arabic": {
        "$type": "fontFamily",
        "$value": [
          "SIRAJ Digits",
          "Tajawal",
          "Geeza Pro",
          "Tahoma",
          "sans-serif"
        ],
        "$description": "Tajawal with Western digits from Jost (SIRAJ Digits)."
      },
      "latin": {
        "$type": "fontFamily",
        "$value": [
          "Jost",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "numeric": {
        "$type": "fontFamily",
        "$value": [
          "Jost",
          "SIRAJ Digits",
          "Tajawal",
          "sans-serif"
        ],
        "$description": "Numbers, pricing and data."
      }
