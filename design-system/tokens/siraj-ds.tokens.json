        "family": "arabic",
        "desktop": 64,
        "mobile": 40,
        "weight": 300,
        "lineHeight": 1.42,
        "letterSpacing": "0"
      },
      "en": {
        "family": "latin",
        "desktop": 60,
        "mobile": 38,
        "weight": 300,
        "lineHeight": 1.08,
        "letterSpacing": "-0.005em"
