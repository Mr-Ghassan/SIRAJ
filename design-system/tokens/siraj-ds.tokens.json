{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$version": "1.0.0",
  "$description": "SIRAJ Design System v1.0 — single source of truth for colour, type, space, grid, shape, elevation, layout, breakpoints, layers, motion hooks and component tokens. Arabic-first (RTL) with full English (LTR) support. Brand values are identical to 09-Design-System/tokens/siraj.tokens.json; motion levels come from motion-system/tokens/siraj-motion-levels.json. Build: node tools/build-design-system.js",
  "$extensions": {
    "siraj": {
      "prefix": "siraj",
      "themes": {
        "light": "ivory",
        "dark": "deep"
      },
      "sources": [
        "09-Design-System/tokens/siraj.tokens.json",
        "motion-system/tokens/siraj-motion-levels.json",
        "04-Grids/grids.json"
      ]
    }
  },
