{
  "name": "siraj-brand",
  "version": "1.0.0",
  "private": true,
  "description": "SIRAJ Real Estate Development — Brand Identity v1.0 build tooling",
  "scripts": {
    "build": "npm run build:tokens && npm run build:colours && npm run build:logos && npm run build:type && npm run build:grids && npm run build:graphics && npm run build:icons && npm run build:index",
    "build:tokens": "node tools/build-tokens.js",
    "build:colours": "python3 tools/build-colours.py",
    "build:logos": "node tools/build-logos.js",
    "build:type": "node tools/build-type.js",
    "build:grids": "node tools/build-grids.js",
    "build:graphics": "node tools/build-graphics.js",
    "build:icons": "node tools/build-icons.js",
    "build:lut": "python3 tools/siraj-grade.py lut",
    "build:social": "node tools/build-social.js && node tools/build-social-v1.js",
    "build:print": "node tools/build-print.js",
    "build:presentations": "python3 tools/build-presentation-v1.py",
    "build:motion": "node tools/build-motion-data.js && node tools/build-motion-system.js && node tools/build-motion.js intro outro transitions components && bash tools/mux-sound.sh",
    "build:guidelines": "node tools/build-guidelines.js",
    "build:index": "node tools/build-index.js",
    "build:silk-cg": "node tools/build-silk.js",
    "build:silk-photo": "python3 tools/silk-photo-import.py",
    "build:kit": "bash tools/build-kit.sh",
    "build:project-siraj": "node tools/build-project-siraj-kv.js && node tools/build-project-siraj-hero.js && node tools/build-project-siraj-facade.js && node tools/build-project-siraj-wrap.js",
    "build:ds": "node tools/build-design-system.js && node tools/build-design-system-docs.js",
    "grade:luxe": "python3 tools/siraj-luxe-grade.py",
    "qa": "node tools/qa-brand.js && node tools/build-design-system-docs.js",
    "qa:silk": "python3 tools/qa-silk.py",
    "build:logo-matrix": "node tools/build-logo-matrix.js",
    "build:webfonts": "python3 -I tools/build-webfonts.py",
    "build:master-library": "python3 -I tools/build-master-library.py",
    "audit:library": "python3 -I tools/audit-library.py",
    "qa:library": "python3 -I tools/qa-library.py"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/jost": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "harfbuzzjs": "^0.4.7",
    "opentype.js": "^1.3.4",
    "svgo": "^3.3.5"
  }
}
