{
  "$description": "SIRAJ Motion Tokens v1.0 — extension spec. Merged with ../siraj-motion-levels.json (the six levels, unchanged) by tools/build-motion-system.js into ../siraj-motion.tokens.json, build/siraj-motion.css, build/siraj-motion.ts and build/siraj-motion.js. Edit this file or the levels file, never the generated outputs.",
  "$version": "1.0.0",
  "easingExtra": {
    "release": {
      "bezier": [
        0.5,
        0,
        0.75,
        0.25
      ],
      "use": "exits — leaves calmly, accelerating away"
    },
    "micro": {
      "bezier": [
        0.2,
        0,
        0,
        1
      ],
      "use": "UI feedback only"
    },
    "linear": {
      "bezier": [
        0,
        0,
        1,
        1
      ],
      "use": "time-mapping real footage only, never for visible UI movement"
    }
  },
  "levelExtra": {
    "micro": {
      "exit": 90,
      "principle": "SETTLE",
      "ar": "دقيق"
    },
    "fast": {
      "exit": 140,
      "principle": "SETTLE",
      "ar": "سريع"
    },
    "standard": {
      "exit": 240,
      "principle": "FLOW",
      "ar": "قياسي"
    },
    "emphasis": {
      "exit": 360,
      "principle": "DRAPE",
      "ar": "إبراز"
    },
    "hero": {
      "exit": 640,
      "principle": "REVEAL",
      "ar": "بطولي"
    },
    "cinematic": {
      "exit": 1200,
      "principle": "GLIDE",
      "ar": "سينمائي"
    }
  },
  "principles": {
    "AIR": {
      "ar": "هواء",
      "meaning": "The driving force behind every soft movement: the silk moves because a breeze passes through it, and the trees, palms and plants in and around the project sway with the same air. One prevailing direction per scene (right → left), slow travelling waves, at most one gentle gust per film, then SETTLE. The architecture never moves. Source: motion-system/tokens/siraj-wind.json.",
      "ease": "flow (gust rise) · drape (gust fall)",
      "levels": [
        "standard",
        "emphasis",
        "hero",
        "cinematic"
      ]
    },
    "FLOW": {
      "ar": "انسياب",
      "meaning": "Movement enters with continuous momentum; nothing starts or stops mechanically.",
      "ease": "flow",
      "levels": [
        "standard",
        "emphasis"
      ]
    },
    "DRAPE": {
      "ar": "انسدال",
      "meaning": "Elements arrive and settle like falling fabric — fast in, long soft deceleration, no overshoot.",
      "ease": "drape",
      "levels": [
        "micro",
        "fast",
        "emphasis"
      ]
    },
    "REVEAL": {
      "ar": "كشف",
      "meaning": "Content is uncovered, never pushed in: masks along a curved silk edge, lines rising from behind a mask.",
      "ease": "reveal",
      "levels": [
        "hero"
      ]
    },
    "WRAP": {
      "ar": "التفاف",
      "meaning": "Real silk footage passes in front of or behind the architecture, using a cut-out of the building.",
      "ease": "linear (footage time-map)",
      "levels": [
        "cinematic"
      ]
    },
    "FOLD": {
      "ar": "طيّ",
      "meaning": "Transitions behave like a controlled material fold; the folded material is photographed silk.",
      "ease": "fold",
      "levels": [
        "hero"
      ]
    },
    "GLIDE": {
      "ar": "انزلاق",
      "meaning": "Camera and position moves are slow, smooth and confident — dolly or crane, never rotation.",
      "ease": "glide",
      "levels": [
        "cinematic"
      ]
    },
    "SETTLE": {
      "ar": "استقرار",
      "meaning": "Every animation ends in a calm, precise rest: the final 30–40% decelerates, images settle 1.04 → 1.00 (never above 1.08).",
      "ease": "drape",
      "levels": [
        "micro",
        "fast",
        "standard",
        "emphasis",
        "hero",
        "cinematic"
      ]
    }
  },
  "settle": {
    "tailFraction": [
      0.3,
      0.4
    ],
    "imageScale": [
      1.04,
      1
    ],
    "maxScale": 1.08,
    "rule": "Every move decelerates over its last 30–40%; the last frame of every component is a still, readable rest."
  },
  "camera": {
    "none": {
      "levels": [
        "micro",
        "fast",
        "standard",
        "emphasis"
      ]
    },
    "pushIn": {
      "amount": 0.02,
      "ease": "glide",
      "level": "hero",
      "rule": "slow push-in 2% (scale 1.02 → 1.00 settle, or 1.00 → 1.02 drift on long holds)"
    },
    "dolly": {
      "amount": 0.04,
      "ease": "glide",
      "level": "cinematic",
      "rule": "dolly / crane up to 4% of frame; no rotation, no roll, no random 3D"
    },
    "parallax": {
      "amount": 0.12,
      "rule": "web only: background moves at 12% of scroll"
    }
  },
  "silk": {
    "rule": "Silk is always real: filmed footage (06-SIRAJ-Silk/Footage) or photographs/cut-outs (06-SIRAJ-Silk/Stills). Never drawn with CSS, SVG or CG. One silk gesture per composition; never over the logo; never hides the building.",
    "axis": 51,
    "direction": "Rises along the 51° Silk Axis from the lower start to the upper end. Arabic (RTL) mirrors layout silk: lower-right → upper-left. Photographs of buildings are never mirrored.",
    "light": "Warm single source from the upper end (upper-left in RTL). Light sweeps are gradients of light, not silk.",
    "wind": "Silk is moved by air (AIR principle): footage is chosen and time-mapped so the cloth travels with one consistent breeze; photographs drift with SirajSilk.drift(); reveal edges ripple with SirajSilk.breathe(); foliage layers use SirajSilk.sway()."
  },
  "reducedMotion": {
    "rule": "Under prefers-reduced-motion every level becomes an opacity-only change of 120ms; no translate, scale, blur or camera. Silk footage is replaced by its still poster frame; transitions become a 120ms cross-fade.",
    "duration": 120,
    "ease": "linear",
    "properties": [
      "opacity"
    ]
  },
  "forbidden": [
    "bounce",
    "elastic / overshoot springs (ζ < 1) on UI, text or logo",
    "glitch, RGB split, shake",
    "spin, rotation of the logo or text",
    "flashy or excessive zoom (scale > 1.08)",
    "random 3D",
    "gold clichés, lens flares, sparkles",
    "whip pans",
    "CSS / vector / CG silk",
    "silk or foliage moving with no air logic (rigid tween, looping wobble)",
    "storm, flapping, high-frequency flutter",
    "silk and foliage moving in opposite directions",
    "wind that bends or moves the architecture"
  ],
  "transitions": {
    "silk-sweep": {
      "name_ar": "مسح الحرير",
      "level": "cinematic",
      "duration": 2400,
      "ease": "reveal",
      "principles": [
        "FLOW",
        "REVEAL"
      ],
      "silk": "footage: SIRAJ_Silk_Ribbon-Pass (mirrored in RTL), scaled to a broad plane",
      "behaviour": "The real ribbon footage, scaled to a broad plane and mirrored for RTL, glides along the diagonal; scene B is revealed behind its trailing edge (the feathered mask edge is locked to the measured footage track), then settles 1.04 → 1.00."
    },
    "silk-fold": {
      "name_ar": "طيّة الحرير",
      "level": "hero",
      "duration": 1200,
      "ease": "fold",
      "principles": [
        "FOLD",
        "SETTLE"
      ],
      "silk": "photograph: SIRAJ_Silk_Fold-Corner (real silk still) seen as the folded flap along the crease",
      "behaviour": "Scene A folds away along a curved diagonal crease that travels from the lower start to the upper end; the folded flap is photographed silk catching the light, a soft fold shadow falls on B, and B settles 1.04 → 1.00."
    },
    "ribbon-pass": {
      "name_ar": "عبور الشريط",
      "level": "cinematic",
      "duration": 2400,
      "ease": "glide",
      "principles": [
        "FLOW",
        "GLIDE"
      ],
      "silk": "footage: SIRAJ_Silk_Ribbon-Pass",
      "behaviour": "A slim real ribbon passes through along the diagonal; B is revealed behind the ribbon's mid-line (feathered, locked to the footage track) and settles 1.04 → 1.00."
    },
    "architectural-reveal": {
      "name_ar": "الكشف المعماري",
      "level": "cinematic",
      "duration": 2400,
      "ease": "reveal",
      "principles": [
        "REVEAL",
        "WRAP"
      ],
      "silk": "footage: SIRAJ_Silk_Ribbon-Pass flowing through the opening columns",
      "behaviour": "Twelve architectural columns open from the centre outwards to reveal B while the real ribbon flows through."
    },
    "light-reveal": {
      "name_ar": "كشف الضوء",
      "level": "cinematic",
      "duration": 2400,
      "ease": "glide",
      "principles": [
        "REVEAL",
        "SETTLE"
      ],
      "silk": "none — light only",
      "behaviour": "A warm band of light passes across scene A along the Silk Axis from the upper end; at its brightest the light carries scene B in behind it, then fades as B settles 1.04 → 1.00. Light is a gradient of warm light, never a flare."
    }
  },
